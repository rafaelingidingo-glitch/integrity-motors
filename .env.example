# Integrity Autocars — environment template
# Copy to `.env` (same folder as app/) and fill in real values.
#   cp .env.example .env
# Real environment variables (e.g. set in cPanel) always override .env values.

# --- Application -------------------------------------------------------------
APP_ENV=production            # production | development
APP_DEBUG=0                   # NEVER 1 in production
APP_URL=https://integrityautocars.co.tz
APP_TIMEZONE=Africa/Dar_es_Salaam

# --- Database (MySQL via cPanel → MySQL Databases) ----------------------------
DB_DRIVER=mysql               # mysql | sqlite (sqlite = local dev only)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=yourcpaneluser_iac
DB_USER=yourcpaneluser_iac
DB_PASS=CHANGE_ME_DB_PASSWORD

# --- Security -----------------------------------------------------------------
# Generate with: php -r "echo bin2hex(random_bytes(32));"
AUTH_SECRET=CHANGE_ME_64_HEX_CHARS

# --- Email (Resend) ------------------------------------------------------------
# https://resend.com → verify your domain → create API key.
# If empty, emails are skipped and logged (site keeps working).
RESEND_API_KEY=
RESEND_FROM="Integrity Autocars <noreply@integrityautocars.co.tz>"
ADMIN_NOTIFY_EMAIL=           # optional; defaults to settings.display_email
